<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_bringup</name>
  <version>0.0.1</version>
  <description>Top-level launch tying gazebo, sensor fusion, the static obstacle map, and nav2 (with auv_planning's custom planner) together for the pralay2_nav_sim sandbox.</description>
  <maintainer email="auv@gofloat.tech">pralay2_nav_sim sandbox</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>auv_gazebo</exec_depend>
  <exec_depend>auv_control</exec_depend>
  <exec_depend>auv_localization</exec_depend>
  <exec_depend>auv_navigation</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
