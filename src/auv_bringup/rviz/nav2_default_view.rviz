Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Value: /map
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: GlobalCostmap
      Topic:
        Value: /global_costmap/costmap
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: LocalCostmap
      Topic:
        Value: /local_costmap/costmap
      Enabled: false
    # Nav2's own plans are 2-D and drawn at z = 0, the surface. Kept for
    # reference but off by default; the *AtDepth copies below (from
    # auv_bringup's plan_at_depth) are the same paths at the held depth,
    # where the hull actually flies them.
    - Class: rviz_default_plugins/Path
      Name: GlobalPlan (surface)
      Topic:
        Value: /plan
      Color: 255; 128; 0
      Alpha: 0.4
      Enabled: false
    - Class: rviz_default_plugins/Path
      Name: LocalPlan (surface)
      Topic:
        Value: /local_plan
      Color: 0; 255; 0
      Alpha: 0.4
      Enabled: false
    - Class: rviz_default_plugins/Path
      Name: GlobalPlanAtDepth
      Topic:
        Value: /plan_at_depth
      Color: 255; 128; 0
      Line Style: Billboards
      Line Width: 0.15
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: LocalPlanAtDepth
      Topic:
        Value: /local_plan_at_depth
      Color: 0; 255; 0
      Line Style: Billboards
      Line Width: 0.1
      Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: FilteredOdometry
      Topic:
        Value: /odometry/filtered
      Enabled: false
  Global Options:
    Fixed Frame: map
    Background Color: 10; 20; 35
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    # rviz_default_plugins/SetGoal, not nav2_rviz_plugins/GoalTool: the Nav2
    # tool only feeds the Navigation2 panel (which this config does not
    # load), so clicking it did nothing. This one publishes the clicked pose
    # as a PoseStamped, and it is pointed at /mission/goal_pose rather than
    # Nav2's own /goal_pose so auv_bringup's dive_and_navigate can hold the
    # goal until the hull is at depth, then release it to Nav2.
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /mission/goal_pose
  Views:
    # Orbit, not TopDownOrtho: a top-down view hides z, which is the point
    # of the 3-D EKF + at-depth paths. The grid is the surface (map z = 0).
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30
      Pitch: 0.45
      Yaw: 3.9
      Target Frame: base_link
Window Geometry:
  Height: 1000
  Width: 1600
