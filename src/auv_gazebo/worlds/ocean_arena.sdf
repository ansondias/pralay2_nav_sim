<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="ocean_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Scenario-wide current: mirror these two numbers into
         auv_navigation/config/nav2_params.yaml's GridBased.water_current_speed /
         water_current_direction_north so the planner is told about the same
         current the sim is applying. See auv_gazebo/README.md. -->
    <plugin filename="ocean_current" name="auv_current_plugin::OceanCurrent">
      <link_name>base_link</link_name>
      <speed>0.4</speed>
      <direction_north_deg>135.0</direction_north_deg>
      <drag_coefficient>1.0</drag_coefficient>
      <fluid_density>1025</fluid_density>
      <cross_section_area>0.3</cross_section_area>
      <topic>/model/auv/ocean_current</topic>
    </plugin>

    <scene>
      <ambient>0.15 0.2 0.35 1.0</ambient>
      <background>0.05 0.12 0.28 1.0</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.5 0.6 0.7 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.3 0.3 -0.9</direction>
    </light>

    <!-- seafloor, 40m x 40m, z=0 -->
    <model name="seafloor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.22 0.15 1</ambient>
            <diffuse>0.35 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- boundary walls, keep the arena bounded to match the static map -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 19.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>40 1 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>40 1 3</size></box></geometry>
          <material><ambient>0.15 0.18 0.22 1</ambient><diffuse>0.2 0.24 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -19.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>40 1 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>40 1 3</size></box></geometry>
          <material><ambient>0.15 0.18 0.22 1</ambient><diffuse>0.2 0.24 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>19.5 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 40 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1 40 3</size></box></geometry>
          <material><ambient>0.15 0.18 0.22 1</ambient><diffuse>0.2 0.24 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-19.5 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 40 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1 40 3</size></box></geometry>
          <material><ambient>0.15 0.18 0.22 1</ambient><diffuse>0.2 0.24 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- reef / rock obstacles: coordinates mirrored in
         auv_bringup/scripts/generate_map.py so the static costmap matches -->
    <model name="reef_1">
      <static>true</static>
      <pose>8 5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 3 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3 3 2</size></box></geometry>
          <material><ambient>0.3 0.25 0.2 1</ambient><diffuse>0.4 0.32 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="reef_2">
      <static>true</static>
      <pose>-6 10 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>2</radius><length>2</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>2</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.3 0.25 0.2 1</ambient><diffuse>0.4 0.32 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="reef_3">
      <static>true</static>
      <pose>0 -8 1 0 0 0.6</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4 2 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4 2 2</size></box></geometry>
          <material><ambient>0.3 0.25 0.2 1</ambient><diffuse>0.4 0.32 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="reef_4">
      <static>true</static>
      <pose>12 -10 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>1.5</radius><length>2</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>1.5</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.3 0.25 0.2 1</ambient><diffuse>0.4 0.32 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="reef_5">
      <static>true</static>
      <pose>-12 -4 1 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 6 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2 6 2</size></box></geometry>
          <material><ambient>0.3 0.25 0.2 1</ambient><diffuse>0.4 0.32 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
