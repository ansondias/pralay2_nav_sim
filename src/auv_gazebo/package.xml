<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_gazebo</name>
  <version>0.0.1</version>
  <description>Ocean-arena Gazebo (gz-sim / Harmonic) world, spawn and ros_gz bridge launch files for the pralay2_nav_sim sandbox.</description>
  <maintainer email="auv@gofloat.tech">pralay2_nav_sim sandbox</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>auv_description</exec_depend>
  <exec_depend>auv_current_plugin</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
