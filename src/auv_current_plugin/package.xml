<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_current_plugin</name>
  <version>0.0.1</version>
  <description>Gazebo (gz-sim) system plugin that applies a configurable horizontal ocean-current drag force to a model link, for testing path planning against water currents.</description>
  <maintainer email="auv@gofloat.tech">pralay2_nav_sim sandbox</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz-cmake3</depend>
  <depend>gz-sim8</depend>
  <depend>gz-plugin2</depend>
  <depend>gz-transport13</depend>
  <depend>gz-msgs10</depend>
  <depend>gz-math7</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
