<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_navigation</name>
  <version>0.0.1</version>
  <description>Default nav2_bringup navigation stack, configured with auv_planning::AStarPlanner as the GridBased global planner plugin.</description>
  <maintainer email="auv@gofloat.tech">pralay2_nav_sim sandbox</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>auv_planning</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
