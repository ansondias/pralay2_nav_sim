<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_control</name>
  <version>0.0.0</version>
  <description>ros2_control controllers (fins + propeller) and the cmd_vel -> actuator mapping for the Pralay-2 AUV, on hardware and under Gazebo (gz_ros2_control).</description>
  <maintainer email="2021ci62f@sigce.edu.in">ros-mad</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- ament_cmake since the depth-hold controller became C++
       (src/depth_hold.cpp); ament_cmake_python still installs the Python
       nodes under their original executable names. See CMakeLists.txt. -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
