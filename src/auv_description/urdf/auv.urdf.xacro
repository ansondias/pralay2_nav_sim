<?xml version="1.0"?>
<robot name="auv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="hull_radius" value="0.15"/>
  <xacro:property name="hull_length" value="1.2"/>
  <xacro:property name="hull_mass" value="20.0"/>
  <xacro:property name="wheel_separation" value="0.4"/>
  <xacro:property name="wheel_radius" value="0.10"/>

  <!-- ============ base ============ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="${hull_radius}" length="${hull_length}"/>
      </geometry>
      <material name="hull_grey">
        <color rgba="0.35 0.38 0.42 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="${hull_length/2} 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <sphere radius="${hull_radius}"/>
      </geometry>
      <material name="hull_grey"/>
    </visual>
    <visual>
      <origin xyz="${-hull_length/2 - 0.03} 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <sphere radius="${hull_radius}"/>
      </geometry>
      <material name="hull_grey"/>
    </visual>
    <!-- tail fins, purely cosmetic -->
    <xacro:macro name="fin" params="yaw">
      <visual>
        <origin xyz="${-hull_length/2 + 0.05} 0 0" rpy="0 0 ${yaw}"/>
        <geometry>
          <box size="0.15 0.02 0.18"/>
        </geometry>
        <material name="fin_orange">
          <color rgba="0.9 0.45 0.1 1.0"/>
        </material>
      </visual>
    </xacro:macro>
    <xacro:fin yaw="0"/>
    <xacro:fin yaw="1.5708"/>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="${hull_radius}" length="${hull_length}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="${hull_mass}"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="${hull_mass * (3*hull_radius*hull_radius + hull_length*hull_length) / 12.0}"
        iyy="${hull_mass * (3*hull_radius*hull_radius + hull_length*hull_length) / 12.0}"
        izz="${hull_mass * hull_radius*hull_radius / 2.0}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <!-- ============ virtual thruster joints (drive DiffDrive kinematics) ============ -->
  <xacro:macro name="virtual_thruster" params="prefix y_offset">
    <link name="${prefix}_thruster_link">
      <visual>
        <geometry><cylinder radius="0.03" length="0.02"/></geometry>
        <material name="fin_orange"/>
      </visual>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}_thruster_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_thruster_link"/>
      <origin xyz="${-hull_length/2} ${y_offset} 0" rpy="1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>
  <xacro:virtual_thruster prefix="left" y_offset="${wheel_separation/2}"/>
  <xacro:virtual_thruster prefix="right" y_offset="${-wheel_separation/2}"/>

  <!-- ============ imu ============ -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="$(find auv_description)/urdf/auv.gazebo.xacro"/>

</robot>
