<?xml version="1.0"?>
<robot name="auv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 2.4 m long, 16 cm diameter hull. hull_mass is *derived* below from
       hull_volume at neutral-buoyancy density, not an independent number;
       update hull_radius/hull_length here and every dependent quantity
       (mass, inertia, frontal/lateral area, buoyant volume) recomputes
       consistently. If a real measured mass is known, hardcode hull_mass
       instead and accept the vehicle will be slightly non-neutrally-buoyant
       (realistic: most real AUVs are trimmed, not exactly neutral). -->
  <xacro:property name="M_PI" value="3.14159265358979"/>
  <xacro:property name="hull_radius" value="0.08"/>
  <xacro:property name="hull_length" value="2.4"/>
  <!-- kg/m^3, nominal seawater; shared with auv_current_plugin::OceanCurrent
       and ::Buoyancy in auv.gazebo.xacro so all three stay consistent. -->
  <xacro:property name="fluid_density" value="1025.0"/>
  <!-- Frontal (nose-on) circle: for OceanCurrent's axial_area. -->
  <xacro:property name="hull_frontal_area" value="${M_PI * hull_radius * hull_radius}"/>
  <!-- Broadside length x diameter rectangle: for OceanCurrent's lateral_area. -->
  <xacro:property name="hull_lateral_area" value="${hull_length * 2 * hull_radius}"/>
  <!-- Cylinder + 2 hemispherical end caps (= 1 full sphere): for Buoyancy's
       hull_volume. -->
  <xacro:property name="hull_volume"
    value="${M_PI * hull_radius * hull_radius * hull_length
            + (4.0 / 3.0) * M_PI * hull_radius * hull_radius * hull_radius}"/>
  <xacro:property name="hull_mass" value="${fluid_density * hull_volume}"/>

  <!-- ============ base ============ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="${hull_radius}" length="${hull_length}"/>
      </geometry>
      <material name="hull_grey">
        <color rgba="0.35 0.38 0.42 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="${hull_length/2} 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <sphere radius="${hull_radius}"/>
      </geometry>
      <material name="hull_grey"/>
    </visual>
    <visual>
      <origin xyz="${-hull_length/2 - 0.03} 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <sphere radius="${hull_radius}"/>
      </geometry>
      <material name="hull_grey"/>
    </visual>
    <!-- tail fins, purely cosmetic -->
    <xacro:macro name="fin" params="yaw">
      <visual>
        <origin xyz="${-hull_length/2 + 0.05} 0 0" rpy="0 0 ${yaw}"/>
        <geometry>
          <box size="0.15 0.02 0.18"/>
        </geometry>
        <material name="fin_orange">
          <color rgba="0.9 0.45 0.1 1.0"/>
        </material>
      </visual>
    </xacro:macro>
    <xacro:fin yaw="0"/>
    <xacro:fin yaw="1.5708"/>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="${hull_radius}" length="${hull_length}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="${hull_mass}"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="${hull_mass * (3*hull_radius*hull_radius + hull_length*hull_length) / 12.0}"
        iyy="${hull_mass * (3*hull_radius*hull_radius + hull_length*hull_length) / 12.0}"
        izz="${hull_mass * hull_radius*hull_radius / 2.0}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <!-- ============ imu ============ -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="$(find auv_description)/urdf/auv.gazebo.xacro"/>

</robot>
