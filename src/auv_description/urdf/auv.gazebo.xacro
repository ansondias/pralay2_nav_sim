<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Treat the AUV as already neutrally buoyant and holding a fixed
       cruising depth: no vertical gravity, no buoyancy engine to tune.
       Horizontal motion is what's being tested (currents + planning),
       so this keeps the sim lightweight and robust; see auv_gazebo/README. -->
  <gazebo reference="base_link">
    <gravity>false</gravity>
  </gazebo>

  <!-- cmd_vel -> planar motion, via two virtual (non-visible-drive) thruster joints -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_thruster_joint</left_joint>
      <right_joint>right_thruster_joint</right_joint>
      <wheel_separation>0.4</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/dvl_odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
      <max_linear_acceleration>2</max_linear_acceleration>
      <min_linear_acceleration>-2</min_linear_acceleration>
      <max_angular_acceleration>3</max_angular_acceleration>
      <min_angular_acceleration>-3</min_angular_acceleration>
    </plugin>
  </gazebo>

  <!-- IMU: system plugin (enables computation) + the sensor itself -->
  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Horizontal ocean current drag force. speed/direction default to 0
       here and are meant to be set per-scenario from the world file or
       live over /model/auv/ocean_current; see auv_gazebo/worlds. -->
  <gazebo>
    <plugin filename="ocean_current" name="auv_current_plugin::OceanCurrent">
      <link_name>base_link</link_name>
      <speed>0.0</speed>
      <direction_north_deg>0.0</direction_north_deg>
      <drag_coefficient>1.0</drag_coefficient>
      <fluid_density>1025</fluid_density>
      <cross_section_area>0.3</cross_section_area>
    </plugin>
  </gazebo>


</robot>
