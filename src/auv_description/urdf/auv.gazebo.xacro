<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Treat the AUV as already neutrally buoyant and holding a fixed
       cruising depth: no vertical gravity, no buoyancy engine to tune.
       Horizontal motion is what's being tested (currents + planning),
       so this keeps the sim lightweight and robust; see auv_gazebo/README. -->
  <gazebo reference="base_link">
    <gravity>false</gravity>
  </gazebo>

  <!-- cmd_vel -> a body-frame thrust force/torque applied directly to the
       hull. DiffDrive won't work here: it moves a robot via simulated
       wheel-to-ground friction, and this AUV never touches the ground
       (gravity disabled, floating at a fixed depth). gz-sim's
       VelocityControl system would work depth-wise but *overwrites* the
       model's velocity every tick, silently cancelling
       auv_current_plugin::OceanCurrent's drag force; ThrustControl
       applies a force instead, so thrust and current genuinely combine
       through physics. -->
  <gazebo>
    <plugin filename="thrust_control" name="auv_current_plugin::ThrustControl">
      <link_name>base_link</link_name>
      <topic>/cmd_vel</topic>
      <linear_gain>400.0</linear_gain>
      <angular_gain>200.0</angular_gain>
    </plugin>
  </gazebo>

  <!-- "DVL-like" odometry: real physics-measured pose/twist (not a
       kinematic echo of the commanded velocity), matching what a DVL +
       depth sensor front-end would actually give the EKF. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>2</dimensions>
      <odom_publish_frequency>20</odom_publish_frequency>
      <odom_topic>/dvl_odom</odom_topic>
    </plugin>
  </gazebo>

  <!-- IMU: system plugin (enables computation) + the sensor itself -->
  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/imu/data</topic>
    </sensor>
  </gazebo>

  <!-- Horizontal ocean current drag force. speed/direction default to 0
       here and are meant to be set per-scenario from the world file or
       live over /model/auv/ocean_current; see auv_gazebo/worlds. -->
  <gazebo>
    <plugin filename="ocean_current" name="auv_current_plugin::OceanCurrent">
      <link_name>base_link</link_name>
      <speed>0.0</speed>
      <direction_north_deg>0.0</direction_north_deg>
      <drag_coefficient>1.0</drag_coefficient>
      <fluid_density>1025</fluid_density>
      <cross_section_area>0.3</cross_section_area>
    </plugin>
  </gazebo>


</robot>
